[Unit]
Description=Service to start the AGL GVM

Requires=qcvirtio-blk-agl.service \
	qcvirtio-gpu-opengl-agl.service \
	qcvirtio-net-agl.service \
	qcvirtio-console-agl.service \
	qcvirtio-rng-agl.service \
	qcvirtio-vsock-agl.service \
	qcvirtio-gpio-agl.service \
	qcvirtio-scmi-agl.service \
	qcvirtio-spi-agl.service \
	qcvirtio-can-agl.service \
	qcvirtio-i2c-agl.service \
	qcvirtio-video-decoder-agl.service \
	qcvirtio-video-encoder-agl.service \
	qcvirtio-rtc-agl.service \
	qcvirtio-input-agl.service \
	qcvirtio-usb-agl.service

Wants=qcvirtio-camera-agl.service

After=qcvirtio-blk-agl.service \
	qcvirtio-gpu-opengl-agl.service \
	qcvirtio-net-agl.service \
	qcvirtio-console-agl.service \
	qcvirtio-rng-agl.service \
	qcvirtio-vsock-agl.service \
	qcvirtio-gpio-agl.service \
	qcvirtio-scmi-agl.service \
	qcvirtio-spi-agl.service \
	qcvirtio-can-agl.service \
	qcvirtio-camera-agl.service \
	qcvirtio-i2c-agl.service \
	qcvirtio-video-decoder-agl.service \
	qcvirtio-video-encoder-agl.service \
	qcvirtio-input-agl.service \
	qcvirtio-rtc-agl.service \
	qcvirtio-usb-agl.service

[Service]
Type=simple
Slice=gvm.slice
ExecStart=/usr/bin/qcrosvm_lv_qcvirtio.sh

[Install]
WantedBy = multi-user.target
