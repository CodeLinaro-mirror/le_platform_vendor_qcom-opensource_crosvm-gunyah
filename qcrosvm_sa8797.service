[Unit]
Description=Service to start the Android GVM
# List of service unit dependencies
Requires=vhost-user-misc.service vhost-user-disp.service vhost-user-gpu.service vhost-user-aud.service vhost-user-vid.service vhost-user-cam.service vhost-user-vnw.service vhost-user-ext.service vhost-user-gpce.service vhost-user-dprx.service vhost-user-eva.service vhost-user-soccp.service vmm-pwr-key.service vhost-user-glinkpassthrough.service vhost-user-frpc.service vhost-device-ssr.service vhost-device-i2c.service vhost-device-gpio.service
After=display-be.service gsl_hab_server.service vhost-user-misc.service vhost-user-disp.service vhost-user-gpu.service vhost-user-aud.service vhost-user-vid.service vhost-user-cam.service vhost-user-vnw.service vhost-user-ext.service vhost-user-gpce.service vhost-user-dprx.service vhost-user-eva.service vhost-user-soccp.service audio-umd.service awe-audio.service hyp-video-be.service qcx_be_server.service vmm-pwr-key.service vhost-user-glinkpassthrough.service vhost-user-frpc.service vhost-device-ssr.service vhost-device-i2c.service disksymlink.service vhost-device-gpio.service
# List of device unit dependencies
Requires=dev-input-vmm\x2dautoghgvm\x2dpwr\x2dkey.device
After=dev-input-vmm\x2dautoghgvm\x2dpwr\x2dkey.device
Wants=gvm-net-config.service

Conflicts = shutdown.target
Before = shutdown.target systemd-udev-trigger.service
DefaultDependencies = no

[Service]
Environment=VMID=52
Environment=KEY=shutdown
# TimeoutShutdownSec: seconds vmm_powerctl waits for qcrosvm to exit.
# TimeoutStopSec must be set to TimeoutShutdownSec + 30s so that systemd
# does not kill the process before vmm_powerctl has finished waiting.
Environment=TimeoutShutdownSec=60
TimeoutStopSec=90s
Type=simple
Slice=gvm.slice
ExecStop=/usr/bin/vm_powerctl -v ${VMID} -k ${KEY} \
            -t ${TimeoutShutdownSec} -p ${MAINPID}
ExecStart=/usr/bin/qcrosvm \
--vm=autoghgvm \
--use-non-protected-virtio \
--disk=/dev/disk/by-partlabel/la_devinfo,label=21,rw=true \
--disk=/dev/disk/by-partlabel/la_init_boot_a,label=22,rw=true \
--disk=/dev/disk/by-partlabel/la_init_boot_b,label=23,rw=true \
--disk=/dev/disk/by-partlabel/la_vendor_boot_a,label=24,rw=true \
--disk=/dev/disk/by-partlabel/la_vendor_boot_b,label=25,rw=true \
--disk=/dev/disk/by-partlabel/dsp_a,label=26,rw=false \
--disk=/dev/disk/by-partlabel/dsp_b,label=27,rw=false \
--disk=/dev/disk/by-partlabel/la_dtbo_a,label=28,rw=true \
--disk=/dev/disk/by-partlabel/la_dtbo_b,label=29,rw=true \
--disk=/dev/disk/by-partlabel/la_boot_a,label=2A,rw=true \
--disk=/dev/disk/by-partlabel/la_boot_b,label=2B,rw=true \
--disk=/dev/disk/by-partlabel/bluetooth_a,label=2C,rw=false \
--disk=/dev/disk/by-partlabel/bluetooth_b,label=2D,rw=false \
--disk=/dev/disk/by-partlabel/modem_a,label=2E,rw=false \
--disk=/dev/disk/by-partlabel/modem_b,label=2F,rw=false \
--disk=/dev/disk/by-partlabel/la_vbmeta_a,label=30,rw=true \
--disk=/dev/disk/by-partlabel/la_vbmeta_b,label=31,rw=true \
--disk=/dev/disk/by-partlabel/la_misc,label=32,rw=true \
--disk=/dev/disk/by-partlabel/la_persist,label=33,rw=true \
--disk=/dev/disk/by-partlabel/la_metadata,label=34,rw=true \
--disk=/dev/disk/by-partlabel/la_userdata,label=35,rw=true,dio=true \
--disk=/dev/disk/by-partlabel/la_super,label=36,rw=true \
--disk=/dev/disk/by-partlabel/la_bootloader_a,label=4E,rw=true \
--disk=/dev/disk/by-partlabel/la_bootloader_b,label=4F,rw=true \
--net=true,label=38,ip_addr=10.10.10.10,netmask=255.255.255.0,mac=4A:6F:F0:05:7C:24 \
--net=true,label=37,ip_addr=10.10.10.11,netmask=255.255.255.0,mac=4A:6F:F0:05:7C:25 \
--vhost-user-hab "/tmp/linux-vm2-vnw-skt",label=48,device-id=96,queue-num=2 \
--vhost-user-hab "/tmp/linux-vm2-gpce-skt",label=49,device-id=98,queue-num=2 \
--vhost-user-hab "/tmp/linux-vm2-ext-skt",label=4A,device-id=97,queue-num=6 \
--vhost-user-hab "/tmp/linux-vm2-soccp-skt",label=4B,device-id=99,queue-num=2 \
--vhost-user-hab "/tmp/linux-vm2-dprx-skt",label=4C,device-id=100,queue-num=4 \
--vhost-user-hab "/tmp/linux-vm2-eva-skt",label=4D,device-id=101,queue-num=2 \
--vhost-user-hab "/tmp/linux-vm2-disp-skt",label=3C,device-id=93,queue-num=10 \
--vhost-user-hab "/tmp/linux-vm2-ogles-skt",label=39,device-id=94,queue-num=2 \
--vhost-user-hab "/tmp/linux-vm2-misc-skt",label=3A,device-id=90,queue-num=2 \
--vhost-user-hab "/tmp/linux-vm2-aud-skt",label=3B,device-id=91,queue-num=8 \
--vhost-user-hab "/tmp/linux-vm2-vid-skt",label=3D,device-id=95,queue-num=6 \
--vhost-user-hab "/tmp/linux-vm2-cam-skt",label=3E,device-id=92,queue-num=4 \
--vhost-user-scmi "/tmp/pt-dev-skt",label=42 \
--input=/dev/input/usb1_touchscreen0,label=3F \
--input=/dev/input/vmm-autoghgvm-pwr-key,label=40 \
--vhost-user-gp /tmp/gp_hello,label=44 \
--vhost-user-frpc "/tmp/sock_file_frpc",label=45 \
--vhost-user-ssr "/tmp/linux-vm2-ssr-skt0",label=47 \
--vhost-user-i2c "/tmp/linux-vm2-i2c-skt0",label=51 \
--vhost-user-eavb "/tmp/linux-vm2-eavb-skt",label=52 \
--vhost-user-gpio "/tmp/linux-vm2-gpio-skt0",label=53 \
--console=/tmp/la_gvm.txt,label=41 \
--vsock cid=100,label=43

# Prevent this critical service from being killed by the OOM killer
OOMScoreAdjust=-1000

[Install]
WantedBy = multi-user.target
